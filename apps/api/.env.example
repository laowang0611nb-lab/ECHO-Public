ECHO_ENVIRONMENT=development
ECHO_DEVELOPMENT_AUTH_ENABLED=true
ECHO_RETRIEVAL_MAX_DISTANCE=0.65
ECHO_DATABASE_URL=postgresql+asyncpg://echo:echo@localhost:5432/echo
ECHO_DOCUMENT_STORAGE_ROOT=tmp/uploads
ECHO_MAX_UPLOAD_BYTES=20971520
ECHO_LLM_API_KEY=
ECHO_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ECHO_LLM_MODEL=qwen3.8-flash
ECHO_LLM_TIMEOUT_SECONDS=60
ECHO_LLM_MAX_CONTEXT_CHARS=60000
ECHO_CHAT_API_KEY=
ECHO_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ECHO_CHAT_MODEL=qwen3.8-flash
ECHO_CHAT_TIMEOUT_SECONDS=60
ECHO_EMBEDDING_API_KEY=
ECHO_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ECHO_EMBEDDING_MODEL=text-embedding-v3
ECHO_EMBEDDING_DIMENSION=1024
ECHO_EMBEDDING_BATCH_SIZE=10
ECHO_CHUNK_SIZE_CHARS=1200
ECHO_CHUNK_OVERLAP_CHARS=200
ECHO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
