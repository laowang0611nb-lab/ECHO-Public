# Shared local defaults. Copy values into the application-specific .env files.
ECHO_ENVIRONMENT=development
ECHO_DATABASE_URL=postgresql+asyncpg://echo:echo@localhost:5432/echo
ECHO_BUSINESS_TIMEZONE=Asia/Shanghai
ECHO_AUTH_SECRET_KEY=development-only-change-me-0000000000
ECHO_AUTH_JWT_ALGORITHM=HS256
ECHO_AUTH_ACCESS_TOKEN_MINUTES=30
ECHO_AUTH_REFRESH_TOKEN_DAYS=14
ECHO_LLM_CONTEXT_WINDOW_TOKENS=1000000
ECHO_LLM_CONTEXT_SAFETY_RATIO=0.7
ECHO_LLM_BATCH_OVERLAP_TOKENS=2000
ECHO_LLM_MAX_OUTPUT_TOKENS=32768
ECHO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
